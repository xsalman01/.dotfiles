#!/bin/bash

# post-merge hook to automatically comment/uncomment branch-specific configurations.
# Also rewrites /home/<user>/ paths in noctalia/settings.toml to the current user.

# Get current branch (target branch)
TARGET_BRANCH=$(git branch --show-current)

# Only run if merging into 'main' or 'laptop'
if [[ "$TARGET_BRANCH" != "main" && "$TARGET_BRANCH" != "laptop" ]]; then
    exit 0
fi

# Determine action based on target branch
if [[ "$TARGET_BRANCH" == "main" ]]; then
    ACTION="enable_desktop"
else
    ACTION="enable_laptop"
fi

# Current user, used to rewrite /home/<user>/ paths dynamically
CURRENT_USER="${USER:-$(whoami)}"

# Files with DESKTOP/LAPTOP comment blocks
FILES=(
    ".zprofile"
    "i3/autostart.i3config"
    "hypr/hyprland.lua"
    "hypr/modules/workspaces.lua"
    "rofi/config.rasi"
    "polybar/modules/tray.ini"
    "polybar/modules/volume.ini"
    "kitty/kitty.conf"
)

# Files where only the /home/<user>/ path needs rewriting
USER_PATH_FILES=(
    "noctalia/settings.toml"
    "rofi/applications/spotify-polybar.desktop"
)

# Rewrite usernames in home paths
for file in "${USER_PATH_FILES[@]}"; do
    [ -f "$file" ] || continue
    echo "Setting home paths in $file to /home/$CURRENT_USER/"
    sed -i -E "s#/home/[^/\"]+/#/home/${CURRENT_USER}/#g" "$file" \
        || echo "  -> ERROR: failed to update $file"
done

# Process each comment-block file
for file in "${FILES[@]}"; do
    [ -f "$file" ] || continue

    echo "Processing $file for branch $TARGET_BRANCH"

    case "$file" in
        *.rasi)        COMMENT="//" ;;
        *.kdl)         COMMENT="//" ;;
        *.lua)         COMMENT="--" ;;
        *)             COMMENT="#"  ;;
    esac

    awk -v action="$ACTION" -v comment="$COMMENT" '
        /### DESKTOP START ###/ { in_desktop = 1; print; next }
        /### DESKTOP END ###/   { in_desktop = 0; print; next }
        /### LAPTOP START ###/  { in_laptop  = 1; print; next }
        /### LAPTOP END ###/    { in_laptop  = 0; print; next }

        {
            if (in_desktop) {
                if (action == "enable_desktop") {
                    sub("^" comment "[ ]?", "", $0)
                } else {
                    if ($0 !~ "^" comment) $0 = comment " " $0
                }
            }
            else if (in_laptop) {
                if (action == "enable_laptop") {
                    sub("^" comment "[ ]?", "", $0)
                } else {
                    if ($0 !~ "^" comment) $0 = comment " " $0
                }
            }
            print
        }
    ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
done

exit 0
